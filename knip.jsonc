{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@next/eslint-plugin-next",
    "@testing-library/jest-dom",
    "eslint-config-next",
    "jscpd",
    // CodeGraph is invoked through documented bunx commands, which static import analysis cannot see.
    "@colbymchenry/codegraph"
  ],
  "ignore": [
    ".worktrees/**",
    ".codex/**",
    ".agents/**",
    ".claude/**",
    ".serena/**",
    ".remember/**",
    ".cache/**",
    ".dev/**",
    ".uv-cache/**",
    ".venv/**",
    ".vercel/**",
    ".next/**"
  ],
  "ignoreBinaries": ["uv"],
  "lefthook": false
}
