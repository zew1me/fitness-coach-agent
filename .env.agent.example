# Agent preview-E2E credentials. Copy to .env.agent (gitignored), or let
# `scripts/setup-agent-e2e.sh` write it for you. Read by tools/agent-inbox.
# Verify at any time with: scripts/setup-agent-e2e.sh --check
# Never point these at production; the preview Supabase project ref is psbteexygkspyotkyflc.

# H1. Resend's managed catch-all receiving domain, like abc123.resend.app (no DNS needed).
# Resend dashboard → Emails → Receiving → ⋯ → Receiving address. Throwaway test
# addresses are minted as <random>@<this domain>.
AGENT_INBOX_DOMAIN=

# H2. Full-access Resend API key named `agent-inbox-reader`. Sending-only keys cannot read
# received mail. Resend dashboard → API Keys → Create API key → Full access.
RESEND_INBOX_API_KEY=

# H3. The invite code that gates sign-up on preview deployments. Same value as the
# preview-scoped INVITE_CODE in Vercel (Project → Settings → Environment Variables);
# the wizard tries `vercel env pull --environment=preview`, then prompts if it is sensitive.
INVITE_CODE=

# H4. Vercel "Protection Bypass for Automation" secret, sent as the
# x-vercel-protection-bypass header. Vercel → Project → Settings → Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=

# H5. Preview Supabase project URL and service-role key (used to purge test users).
# Defaults to SUPABASE_URL_PREVIEW / SUPABASE_SERVICE_ROLE_KEY_PREVIEW in .env.bootstrap;
# otherwise Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
